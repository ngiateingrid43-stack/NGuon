{
  "name": "heritage-rise-of-africa",
  "version": "2.1.0",
  "description": "HÉRITAGE – RISE OF AFRICA : FPS multijoueur voxel 3D inspiré des civilisations et traditions africaines.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "tsx watch server/src/server.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:pc": "node scripts/build-standalone.mjs",
    "start": "NODE_ENV=production node dist/server/server/src/server.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,css,html,md,json}\""
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
